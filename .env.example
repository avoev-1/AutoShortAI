APP_ENV=development
APP_NAME=AutoShortAI
APP_VERSION=0.1.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

DATABASE_URL=postgresql+asyncpg://autoshort:autoshort@postgres:5432/autoshort
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:5173

ENABLE_REAL_PUBLISHING=false
ENABLE_PAID_APIS=false
DAILY_API_BUDGET_USD=0
MAX_DAILY_PUBLICATIONS=0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
ELEVENLABS_API_KEY=
